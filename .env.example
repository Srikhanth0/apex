# Copy to .env for local pipeline runs (python -m pipeline). Never commit .env.
# In GitHub, set these as repository secrets / variables instead (Settings → Secrets and variables → Actions).

# AI enrichment is optional. Without a key, summaries are the article's own sentences.
AI_PROVIDER=auto                 # auto | gemini | openai-compatible | none
GEMINI_API_KEY=                  # secret: free key from Google AI Studio
AI_MODEL=                        # optional, e.g. gemini-2.5-flash or llama-3.3-70b-versatile
AI_BASE_URL=                     # for openai-compatible, e.g. https://api.groq.com/openai/v1
AI_API_KEY=                      # secret: key for the openai-compatible provider

# Phone notifications (coach nudges and job alerts)
NTFY_TOPIC=                      # secret: a long private ntfy topic name

# Crawler tuning (defaults shown)
APEX_TIMEOUT=20
APEX_WORKERS=6
APEX_PER_HOST_DELAY=1.0
APEX_RETRIES=3
APEX_ARTICLE_RETENTION_DAYS=45
APEX_JOB_RETENTION_DAYS=30
